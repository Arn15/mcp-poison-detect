% ---------------------------------------------------------------------------
% LOCAL STAND-IN for the official neurips_2024.sty
% (media.neurips.cc was unreachable when this was built). It reproduces the
% official layout: US letter, 5.5in x 9in text block, Times 10/11pt,
% title between rules, 12pt bold sections, no paragraph indent.
% To use the official file, just replace this file with neurips_2024.sty from
% https://media.neurips.cc/Conferences/NeurIPS2024/Styles.zip -- main.tex
% already calls \usepackage[preprint]{neurips_2024}.
% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/03/31 NeurIPS 2024 (local stand-in)]

\newif\if@preprint\@preprintfalse
\newif\if@natbib\@natbibtrue
\DeclareOption{preprint}{\@preprinttrue}
\DeclareOption{final}{\@preprintfalse}
\DeclareOption{nonatbib}{\@natbibfalse}
\ProcessOptions\relax

\if@natbib\RequirePackage{natbib}\fi
\RequirePackage[letterpaper,textheight=9in,textwidth=5.5in,top=1in,
  headheight=12pt,headsep=25pt,footskip=30pt]{geometry}
\RequirePackage{mathptmx}

\renewcommand{\normalsize}{\@setfontsize\normalsize\@xpt\@xipt
  \abovedisplayskip 7\p@ \@plus 2\p@ \@minus 5\p@
  \abovedisplayshortskip \z@ \@plus 3\p@
  \belowdisplayskip \abovedisplayskip
  \belowdisplayshortskip 4\p@ \@plus 3\p@ \@minus 3\p@}
\normalsize
\renewcommand{\small}{\@setfontsize\small\@ixpt\@xpt}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize\@ixpt\@xpt}
\renewcommand{\scriptsize}{\@setfontsize\scriptsize\@viipt\@viiipt}
\renewcommand{\large}{\@setfontsize\large\@xiipt{14}}
\renewcommand{\Large}{\@setfontsize\Large\@xivpt{16}}

\setlength{\parindent}{\z@}
\setlength{\parskip}{5.5\p@}
\setlength{\footnotesep}{6.65\p@}
\setlength{\skip\footins}{9\p@ \@plus 4\p@ \@minus 2\p@}

\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}{1.5ex \@plus 0.3ex \@minus 0.2ex}%
  {\large\bf\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}{0.8ex \@plus 0.2ex}%
  {\normalsize\bf\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1.5ex \@plus 0.5ex \@minus 0.2ex}{-1em}{\normalsize\bf}}

\providecommand{\@noticestring}{}
\if@preprint
  \renewcommand{\@noticestring}{}
\fi

\def\@toptitlebar{\hrule height4\p@\vskip .25in\vskip -\parskip}
\def\@bottomtitlebar{\vskip .29in\vskip -\parskip\hrule height1\p@\vskip .09in}

\renewcommand{\maketitle}{%
  \par\begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
    \thispagestyle{empty}%
    \@maketitle
    \@thanks
  \endgroup
  \let\maketitle\relax \let\thanks\relax}

\def\@maketitle{%
  \vbox{\hsize\textwidth \linewidth\hsize \vskip 0.1in
    \@toptitlebar \centering {\LARGE\bf \@title\par} \@bottomtitlebar
    \def\And{\end{tabular}\hfil\linebreak[0]\hfil
      \begin{tabular}[t]{c}\bf\rule{\z@}{24\p@}\ignorespaces}%
    \begin{tabular}[t]{c}\bf\rule{\z@}{24\p@}\@author\end{tabular}%
    \vskip 0.3in \@minus 0.1in}}

\renewcommand{\LARGE}{\@setfontsize\LARGE{17}{20}}

\def\ps@empty{\let\@oddhead\@empty\let\@evenhead\@empty
  \def\@oddfoot{\small\@noticestring\hfil}\let\@evenfoot\@oddfoot}
\pagestyle{plain}
\endinput
